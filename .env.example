# Copy to .env.local for development. Never commit real values.
# None of these are exposed to the browser: they have no NEXT_PUBLIC_ prefix and are only
# read in server code (lib/sources/youtube.ts, lib/security/*). Keep it that way.

# --- YouTube Data API v3 (optional, recommended) ---------------------------------
# Enables "Live results from YouTube" in both libraries and refreshes curated videos with
# real durations, view counts, publish dates and availability (deleted/private detection).
# Without it the site runs on the curated library only.
# Create: Google Cloud Console → APIs & Services → Library → enable "YouTube Data API v3"
#         → Credentials → Create credentials → API key.
# Restrict it: API restrictions → "YouTube Data API v3" only. If your server has a static
#         egress IP, also add an IP-address application restriction.
YOUTUBE_API_KEY=

# Local daily budget in API units (search = 100, videos.list = 1). The default project
# quota is 10,000/day; stay below it so the site degrades gracefully instead of failing.
YOUTUBE_DAILY_QUOTA_BUDGET=8000

# Optional two-letter language hint for live search results (e.g. en, de, ja).
YOUTUBE_RELEVANCE_LANGUAGE=en

# --- Request attribution for rate limiting ----------------------------------------
# Which header carries the real client IP. Only trust a header your proxy sets.
#   Vercel:            x-forwarded-for
#   Behind Cloudflare: cf-connecting-ip
#   nginx real_ip:     x-real-ip
#   none:              no trusted proxy (all clients share one bucket; rely on the edge)
TRUSTED_IP_HEADER=x-forwarded-for

# Salt for hashing client IPs in logs and rate-limit keys (raw IPs are never logged).
# Generate with: openssl rand -hex 32
LOG_SALT=

# Extra origins allowed to call the API cross-site (comma-separated). Leave empty: the
# API is designed for same-origin use only.
ALLOWED_ORIGINS=

# Public OAuth client id for "Continue with Google" on My Profile (Web application client;
# add your site's origin under Authorized JavaScript origins). Not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
