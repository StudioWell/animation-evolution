rules_version = '2';

// Cloud Storage rules for uploaded video files (only needed on the Blaze plan,
// with FIREBASE_UPLOADS = true in lib/firebase/config.ts). Replace OWNER_EMAIL.
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{uid}/{file} {
      // Files have random names and are linked only from the author's
      // submission (private) or, once approved, from the public list.
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || (request.auth.token.email == 'OWNER_EMAIL' && request.auth.token.email_verified == true));
    }
  }
}
